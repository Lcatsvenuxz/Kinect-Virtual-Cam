<Window x:Class="KinectControllerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel de Control - Kinect Virtual Cam" Height="720" Width="1080" 
        Background="#2D2D30" WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Dividimos la pantalla: 70% Video, 30% Controles -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <!-- Zona de Renderizado de Video -->
        <Border Grid.Column="0" Margin="10" BorderBrush="#555" BorderThickness="2" Background="Black">
            <Image x:Name="cameraFeed" Stretch="Uniform"/>
        </Border>

        <!-- Zona de Controles (Kinect Explorer Style) -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,10,10,10">
            <StackPanel Background="#4B367C">
                <!-- Fondo morado tipo Kinect Explorer -->

                <!-- SECCIÓN 1: Color Stream -->
                <GroupBox Header="Color Stream" Foreground="White" Margin="10" BorderBrush="White">
                    <StackPanel Margin="5">
                        <RadioButton x:Name="rbColorRgb" Content="RgbResolution640x480Fps30" Foreground="White" IsChecked="True" Margin="0,5"/>
                        <RadioButton x:Name="rbColorRgbHD" Content="RgbResolution1280x960Fps12" Foreground="White" Margin="0,5"/>
                        <RadioButton x:Name="rbColorIr" Content="InfraredResolution640x480Fps30" Foreground="White" Margin="0,5"/>
                        <RadioButton x:Name="rbColorOff" Content="Off" Foreground="White" Margin="0,5"/>
                    </StackPanel>
                </GroupBox>

                <!-- SECCIÓN 2: Depth Stream -->
                <GroupBox Header="Depth Stream" Foreground="White" Margin="10" BorderBrush="White">
                    <StackPanel Margin="5">
                        <RadioButton x:Name="rbDepthOn" Content="Resolution640x480Fps30" Foreground="White" IsChecked="True" Margin="0,5"/>
                        <RadioButton x:Name="rbDepthOff" Content="Off" Foreground="White" Margin="0,5"/>
                        <Separator Margin="0,10"/>
                        <TextBlock Text="Depth Treatment" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                        <RadioButton x:Name="rbDepthClamp" Content="ClampUnreliableDepths" Foreground="White" IsChecked="True" Margin="0,5"/>
                        <RadioButton x:Name="rbDepthDisplayAll" Content="DisplayAllDepths" Foreground="White" Margin="0,5"/>
                    </StackPanel>
                </GroupBox>

                <!-- SECCIÓN 3: Sensor Settings -->
                <GroupBox Header="Sensor Settings" Foreground="White" Margin="10" BorderBrush="White">
                    <StackPanel Margin="5">
                        <TextBlock Text="Tilt Angle" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>

                            <!-- El Slider que controla el motor físico -->
                            <Slider x:Name="sliderTilt" Grid.Column="0" Minimum="-27" Maximum="27" Value="0" 
                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtTiltAngle" Grid.Column="1" Text="0°" Foreground="White" 
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="Image Orientation" Foreground="White" FontWeight="Bold" Margin="0,10,0,5"/>
                        <CheckBox x:Name="chkFlipV" Content="Flip Vertical" Foreground="White" Margin="0,5" IsChecked="True"/>
                        <CheckBox x:Name="chkFlipH" Content="Flip Horizontal" Foreground="White" Margin="0,5"/>
                        
                        <Separator Margin="0,15"/>

                        <TextBlock Text="Infrared Emitter" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                        <CheckBox x:Name="chkForceOffIr" Content="Force Off" Foreground="White" Margin="0,5"/>
                    </StackPanel>
                </GroupBox>

                <!-- Botón de Inyección a Memoria (El puente a OBS) -->
                <Button x:Name="btnToggleInjection" Content="INICIAR KINECT WEBCAM" 
        Height="40" Margin="10,20,10,10" Background="#28A745" Foreground="White" 
        FontWeight="Bold" BorderThickness="0" Click="BtnToggleInjection_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>