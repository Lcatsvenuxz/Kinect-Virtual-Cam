<Window x:Class="KinectControllerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel de Control - Kinect Virtual Cam" Height="720" Width="1080"
        Background="{DynamicResource WindowBgBrush}" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBgBrush" Color="#2D2D30"/>
        <SolidColorBrush x:Key="PanelBgBrush" Color="#4B367C"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ActionBtnBrush" Color="#28A745"/>
    </Window.Resources>

    <Grid>
        <!-- Dividimos la pantalla: 70% Video, 30% Controles (layout clasico original) -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <!-- Zona de Renderizado de Video (cruda del Kinect, sin efectos de espejo) -->
        <Border Grid.Column="0" Margin="10" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" Background="Black">
            <Image x:Name="cameraFeed" Stretch="Uniform"/>
        </Border>

        <!-- Zona de Controles (Kinect Explorer Style original) -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,10,10,10">
            <StackPanel Background="{DynamicResource PanelBgBrush}">

                <!-- Selector sobrio de Idioma y Tema -->
                <GroupBox x:Name="grpPreferences" Header="Idioma / Apariencia" Foreground="White" Margin="10,10,10,5" BorderBrush="{DynamicResource AccentBrush}">
                    <StackPanel Margin="5">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lblLanguage" Text="Idioma:" Foreground="White" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmbLanguage" Grid.Column="1" SelectedIndex="0" Foreground="Black" SelectionChanged="CmbLanguage_SelectionChanged">
                                <ComboBoxItem Content="Español"/>
                                <ComboBoxItem Content="English"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,6,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lblTheme" Text="Tema:" Foreground="White" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmbTheme" Grid.Column="1" SelectedIndex="0" Foreground="Black" SelectionChanged="CmbTheme_SelectionChanged">
                                <ComboBoxItem Content="Dark Purple"/>
                                <ComboBoxItem Content="Midnight Slate"/>
                                <ComboBoxItem Content="Obsidian"/>
                                <ComboBoxItem x:Name="itemThemeCustom" Content="Personalizado"/>
                            </ComboBox>
                        </Grid>

                        <!-- Controles sobrios de color cuando se elige "Personalizado" -->
                        <StackPanel x:Name="pnlCustomColors" Visibility="Collapsed" Margin="0,6,0,0">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="85"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="65"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="lblCustomBg" Text="Fondo:" Foreground="White" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtHexBg" Grid.Column="1" Text="#242428" Margin="0,0,4,0" LostFocus="CustomHex_LostFocus"/>
                                <Button x:Name="btnPickBg" Grid.Column="2" Content="Color..." Click="BtnPickBg_Click"/>
                            </Grid>
                            <Grid Margin="0,4,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="85"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="65"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="lblCustomAccent" Text="Acento:" Foreground="White" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtHexAccent" Grid.Column="1" Text="#3A86FF" Margin="0,0,4,0" LostFocus="CustomHex_LostFocus"/>
                                <Button x:Name="btnPickAccent" Grid.Column="2" Content="Color..." Click="BtnPickAccent_Click"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- SECCIÓN 1: Color Stream -->
                <GroupBox x:Name="grpColorStream" Header="Color Stream" Foreground="White" Margin="10,5" BorderBrush="{DynamicResource AccentBrush}">
                    <StackPanel Margin="5">
                        <RadioButton x:Name="rbColorRgbSD" Content="RgbResolution640x480Fps30" Foreground="White" IsChecked="True" Margin="0,5" Checked="ColorFormat_Checked"/>
                        <RadioButton x:Name="rbColorRgbHD" Content="RgbResolution1280x960Fps12" Foreground="White" Margin="0,5" Checked="ColorFormat_Checked"/>
                        <RadioButton x:Name="rbColorIr" Content="InfraredResolution640x480Fps30" Foreground="White" Margin="0,5" Checked="ColorFormat_Checked"/>
                        <RadioButton x:Name="rbColorOff" Content="Off" Foreground="White" Margin="0,5" Checked="ColorFormat_Checked"/>
                        <TextBlock x:Name="txtResolutionWarning"
                                   Text="Webcam activa. Detenga la transmisión para cambiar la resolución."
                                   Foreground="#FFC107" FontWeight="Bold" TextWrapping="Wrap"
                                   Margin="0,8,0,2" Visibility="Collapsed"/>
                    </StackPanel>
                </GroupBox>

                <!-- SECCIÓN 2: Depth Stream -->
                <GroupBox x:Name="grpDepthStream" Header="Depth Stream (no usado por la camara virtual)" Foreground="Gray" Margin="10,5" BorderBrush="Gray" IsEnabled="False">
                    <StackPanel Margin="5">
                        <RadioButton x:Name="rbDepthOn" Content="Resolution640x480Fps30" Foreground="White" IsChecked="True" Margin="0,5"/>
                        <RadioButton x:Name="rbDepthOff" Content="Off" Foreground="White" Margin="0,5"/>
                        <Separator Margin="0,10"/>
                        <TextBlock x:Name="lblDepthTreatment" Text="Depth Treatment" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                        <RadioButton x:Name="rbDepthClamp" Content="ClampUnreliableDepths" Foreground="White" IsChecked="True" Margin="0,5"/>
                        <RadioButton x:Name="rbDepthDisplayAll" Content="DisplayAllDepths" Foreground="White" Margin="0,5"/>
                    </StackPanel>
                </GroupBox>

                <!-- SECCIÓN 3: Sensor Settings -->
                <GroupBox x:Name="grpSensorSettings" Header="Sensor Settings" Foreground="White" Margin="10,5" BorderBrush="{DynamicResource AccentBrush}">
                    <StackPanel Margin="5">
                        <TextBlock x:Name="lblTiltAngle" Text="Tilt Angle" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>

                            <!-- El Slider que controla el motor físico -->
                            <Slider x:Name="sliderTilt" Grid.Column="0" Minimum="-27" Maximum="27" Value="0"
                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtTiltAngle" Grid.Column="1" Text="0°" Foreground="White"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock x:Name="lblImageOrientation" Text="Image Orientation" Foreground="White" FontWeight="Bold" Margin="0,10,0,5"/>
                        <CheckBox x:Name="chkFlipV" Content="Flip Vertical" Foreground="White" Margin="0,5"/>
                        <CheckBox x:Name="chkFlipH" Content="Flip Horizontal" Foreground="White" Margin="0,5"/>

                        <Separator Margin="0,15"/>

                        <TextBlock x:Name="lblIrEmitter" Text="Infrared Emitter" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                        <CheckBox x:Name="chkForceOffIr" Content="Force Off" Foreground="White" Margin="0,5" Checked="ChkForceOffIr_Changed" Unchecked="ChkForceOffIr_Changed"/>
                    </StackPanel>
                </GroupBox>

                <!-- SECCIÓN 4: Estado -->
                <GroupBox x:Name="grpStatus" Header="Estado" Foreground="White" Margin="10,5" BorderBrush="{DynamicResource AccentBrush}">
                    <StackPanel Margin="5">
                        <TextBlock x:Name="txtSensorStatus" Text="Sensor: ..." Foreground="White" Margin="0,2" TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtClientStatus" Text="Cliente: ninguno conectado" Foreground="White" Margin="0,2" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <!-- Aviso visible cuando la imagen está congelada -->
                <TextBlock x:Name="txtFreezeWarning"
                           Text="IMAGEN CONGELADA (Webcam en pausa)"
                           Foreground="#FFC107" FontWeight="Bold" HorizontalAlignment="Center"
                           TextWrapping="Wrap" Margin="10,6,10,0" Visibility="Collapsed"/>

                <!-- Botón de Congelar Imagen (Freeze Frame) -->
                <Button x:Name="btnFreezeFrame" Content="CONGELAR IMAGEN"
                        Height="34" Margin="10,8,10,0" Background="#495057" Foreground="White"
                        FontWeight="Bold" BorderThickness="0" IsEnabled="False" Click="BtnFreezeFrame_Click"/>

                <!-- Botón de Inyección a Memoria -->
                <Button x:Name="btnToggleInjection" Content="INICIAR KINECT WEBCAM"
                        Height="40" Margin="10,8,10,10" Background="{DynamicResource ActionBtnBrush}" Foreground="White"
                        FontWeight="Bold" BorderThickness="0" Click="BtnToggleInjection_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
